# Copy this to .env.local (never committed) and fill in the real values.
# These must match AUTH_USERNAME / the password behind AUTH_PASSWORD_HASH
# configured in backend/.env.
#
# Note: because the frontend auto-logs in on every page load (no login
# screen), these credentials end up in the built JS bundle shipped to every
# visitor's browser. Keeping them out of git avoids leaking them in the repo,
# but it does not make them secret from site visitors — see the note in
# README.md about this.
VITE_API_USERNAME=
VITE_API_PASSWORD=